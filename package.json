{
  "name": "microapps",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter shell dev",
    "build": "pnpm -r build",
    "check": "tsc --build && oxlint . && pnpm test",
    "test": "pnpm -r --if-present test",
    "typegen": "pnpm -r run types"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "oxlint": "^1.0.0",
    "typescript": "^7.0.0",
    "wrangler": "^4.123.0"
  }
}
