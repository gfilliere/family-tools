{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "admin",
	"main": "src/worker/index.ts",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Without this, admin.<subdomain>.workers.dev would serve the app OUTSIDE
	// Cloudflare Access. Leave it false.
	"workers_dev": false,
	"routes": [
		{
			"pattern": "home.thekleefillieres.com/admin/*",
			"zone_name": "thekleefillieres.com"
		}
	],
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"not_found_handling": "none"
	},
	"d1_databases": [
		{
			"binding": "CORE",
			"database_name": "core",
			"database_id": "REPLACE_ME"
		}
	],
	"observability": {
		"enabled": true
	}
}
