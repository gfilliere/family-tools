{
  "name": "cookbook",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n list,worker,web -c yellow,blue,green \"pnpm --filter list dev:worker\" \"pnpm dev:worker\" \"pnpm dev:web\"",
    "dev:worker": "wrangler dev --port 8787",
    "dev:web": "vite",
    "build": "vite build",
    "deploy": "pnpm build && wrangler deploy",
    "migrate": "wrangler d1 migrations apply cookbook --remote",
    "test": "vitest run",
    "types": "wrangler types"
  },
  "dependencies": {
    "@family-tools/ui": "workspace:*",
    "hono": "^4.6.0",
    "marked": "^16.2.1",
    "preact": "^10.24.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "concurrently": "^10.0.4",
    "vite": "^6.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.123.0"
  }
}
